#!/bin/bash -e

ROOT=`dirname $0`

cd "$ROOT/.."

SKIP_TRANSLATIONS=false
# --mobile builds the variant shipped inside the iOS and Android apps.
TASK=build:browser
while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-translations)
      SKIP_TRANSLATIONS=true
      shift
      ;;
    --mobile)
      TASK=build:mobile
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [ "$SKIP_TRANSLATIONS" = false ]; then
  ./bin/ensure-translations --update
fi

lage "$TASK" --to=@actual-app/web
